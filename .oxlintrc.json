{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "typescript/no-non-null-assertion": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/no-null": "off"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
